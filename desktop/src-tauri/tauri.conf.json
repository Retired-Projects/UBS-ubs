{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UBS",
  "version": "3.11.3",
  "identifier": "ubs.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "UBS",
        "width": 1482,
        "height": 986,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b1016"
      }
    ],
    "security": {
      "capabilities": [
        "main-capability"
      ],
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self'",
        "script-src": "'self'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Fast, safe release builds",
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "bundleVersion": "3.11.9"
    },
    "resources": {
      "../../.env.example": "ubs-runtime/.env.example",
      "../../.env.macos.example": "ubs-runtime/.env.macos.example",
      "../../build.sh": "ubs-runtime/build.sh",
      "../../install.sh": "ubs-runtime/install.sh",
      "../../native/ubs-helper/Cargo.lock": "ubs-runtime/native/ubs-helper/Cargo.lock",
      "../../native/ubs-helper/Cargo.toml": "ubs-runtime/native/ubs-helper/Cargo.toml",
      "../../native/ubs-helper/src/": "ubs-runtime/native/ubs-helper/src/",
      "../../scripts/": "ubs-runtime/scripts/",
      "../../skills/universal-build/": "ubs-runtime/skills/universal-build/",
      "../../templates/": "ubs-runtime/templates/",
      "../../VERSION": "ubs-runtime/VERSION"
    }
  }
}
